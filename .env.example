# ─────────────────────────────────────────────────────────────────────────────
# tgram-analytics server — environment variables
#
# Copy this file to .env and fill in the values.
# Never commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────────────────
# Token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat ID — only this account can interact with the bot.
# Find it by messaging @userinfobot on Telegram.
ADMIN_CHAT_ID=

# ── Database ──────────────────────────────────────────────────────────────────
# Async PostgreSQL connection string (asyncpg driver).
# IMPORTANT: `@db` works for local docker-compose only.
# In Coolify/production use the real database hostname provided by your platform
# (for example the linked DB service host), not `db`.
# Change password to something secure before deploying.
DATABASE_URL=postgresql+asyncpg://tga:changeme@db/tganalytics

# ── Security ──────────────────────────────────────────────────────────────────
# Random secret used for API key signing.  Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Bot webhook ───────────────────────────────────────────────────────────────
# Public HTTPS URL of your server.  The bot registers its webhook at:
#   <WEBHOOK_BASE_URL>/webhook
# Leave empty to use long-polling (development only).
WEBHOOK_BASE_URL=https://your-server.com

# Shared secret Telegram echoes in the X-Telegram-Bot-Api-Secret-Token header
# to authenticate webhook calls — keeps the bot token out of the URL and logs.
# REQUIRED whenever WEBHOOK_BASE_URL is set. Random 32+ chars, A-Za-z0-9_- only:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# ── Sentry (optional error tracking) ──────────────────────────────────────────
# Leave SENTRY_DSN unset to disable Sentry entirely (default for self-host).
# Set the DSN to opt in — sentry-sdk ships as a base dependency.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=                       # commit SHA or version tag; auto-falls back to pkg version
# SENTRY_SERVER_NAME=                   # human-readable instance name; defaults to hostname
# SENTRY_TRACES_SAMPLE_RATE=0.0         # 0..1 — fraction of transactions traced
# SENTRY_PROFILES_SAMPLE_RATE=0.0       # 0..1 — fraction of *traced* transactions profiled
# SENTRY_LOG_LEVEL=INFO                 # min level captured as breadcrumbs (WARNING+ becomes events)
# SENTRY_SEND_DEFAULT_PII=false         # forward request bodies & IPs to Sentry (off by default)

# ── Rate limiting (optional) ──────────────────────────────────────────────────
# Maximum ingestion requests per second per API key (default: 100).
# RATE_LIMIT_PER_SECOND=100

# ── MCP server (optional) ────────────────────────────────────────────
# The /mcp endpoint is enabled by default but inert until you create a
# token with the /mcp_token bot command.
# Behind a TLS proxy (Cloudflare, Coolify) set MCP_PUBLIC_URL=https://your-host
# so OAuth metadata and connect instructions use https.
# MCP_ENABLED=true
# MCP_PUBLIC_URL=            # defaults to WEBHOOK_BASE_URL
# MCP_GITHUB_TOKEN=          # raises GitHub rate limit for docs tools

# ── PostgreSQL container (docker-compose only) ────────────────────────────────
POSTGRES_DB=tganalytics
POSTGRES_USER=tga
POSTGRES_PASSWORD=changeme
